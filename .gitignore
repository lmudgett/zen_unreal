# Build trees and packaged output (regenerated by CMake / build-dist.bat)
/build/
/build-sdl/
/dist/

# Reference baseline (read-only, local-only; scrubbed from git history)
/Unreal - v200/

# Runtime artifacts
/Save/
*.log
Crash.txt
*.probe

# Retail CD image — exceeds GitHub's 100 MB file limit; stays local-only
