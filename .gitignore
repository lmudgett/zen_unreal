.claude/settings.local.json
.vs/
*.user

# Local git-history backups (delete after push is verified)
/.git-backup-pre-github/
/.git-backup-scrub/

# ImGui editor window-layout state (written at editor exit)
System/EdGui.ini
System/Unreal.exe
